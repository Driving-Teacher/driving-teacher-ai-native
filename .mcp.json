{
  "mcpServers": {
    "gdrive": {
      "command": "bash",
      "args": ["scripts/gdrive-mcp.sh"]
    },
    "hackle-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@hackle-io/hackle-mcp@latest"],
      "env": {
        "API_KEY": "${HACKLE_API_KEY}"
      }
    }
  }
}
